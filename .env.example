# Copy to .env.local and fill in. Never commit .env.local.
# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_PUBLISHABLE_OR_ANON_KEY_HERE
# Public URL players' phones open (QR codes encode this). Your Vercel domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dev-only email/password login for testing without Google (never enable in production).
NEXT_PUBLIC_DEV_LOGIN=false
